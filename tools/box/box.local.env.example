# Copy to tools/box/box.local.env (gitignored) and fill in your Windows test box. Sourced by tools/box/box_env.sh.
# Every variable must be set. Windows paths are single-quoted and use backslashes, with no trailing backslash.
# After editing, re-run tools/box/box_setup.sh: it writes the user name and the game folders to the box.

# ssh target of the box (its OpenSSH server must default to Windows PowerShell 5.1)
BOX=user@windows-host
# the Windows account that is logged on at the box; the scheduled tasks run as this user
BOX_WIN_USER=user
# the game's My Games folder on the box (SKSE logs and saves live under it)
BOX_MYGAMES='C:\Users\user\Documents\My Games\Skyrim Special Edition'
# the two game installs (the folder holding SkyrimSE.exe and skse64_loader.exe)
BOX_GAME_DIR_AE1170='C:\Games\Skyrim 1.6.1170'
BOX_GAME_DIR_AE17104='C:\Games\Skyrim 1.7.104'
# the install the tools use when BOX_GAME is not set in the environment: ae1170 (1.6.1170.0) or ae17104 (1.7.104.0)
BOX_GAME=ae1170
