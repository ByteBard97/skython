# Live-test values for the s4test save on the Windows test machine (spikes/RESULTS.md: S4, S7c and S7g). No secrets: form ids and script names only. Use with
#   source livetest/s4test.env && SKYTHON_LIVE=1 uv run --project python pytest livetest -q -rs
# Under SKYTHON_LIVE=1 a test that needs one of these and finds it unset fails instead of skipping.
# They come from one particular throwaway save and go stale with another one.
export SPY_S4_QUEST=0x0010FDD5 SPY_S4_ALIAS=7 SPY_S4_REF=0x0001A677
export SPY_PLAIN_QUEST=0x0010FDD5 SPY_PLAIN_ALIAS=0
export SPY_OWN_QUEST=0x0001C4A1 SPY_OWN_SCRIPT=CWCampaignScript SPY_OWN_FUNCTION=getAttackDeltaMissionBonus
export SPY_OWN_INT_PROPERTY=currentAttackDelta
export SPY_S7C_QUEST=0x001093E4 SPY_S7C_SCRIPT=QF_TGTQ01Handler_001093E4 SPY_S7C_PROPERTY=Alias_TGHandlerSilverMoldAlias SPY_S7C_KIND=Alias
# SPY_S7C_GETTER stays unset: the QF_ script declares no getter for that property.
