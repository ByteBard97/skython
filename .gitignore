# handoff notes are session scratch, not project history
HANDOFF-*.md

# build outputs
build/
*/build/
out/

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# subagent-driven-development workspace (ledgers, briefs, review packages)
.superpowers/

# plugin and Papyrus build artifacts
**/build/
*.dll
*.pdb
*.pex
*.egg-info/
# committed Papyrus build outputs (stable hashes in docs/PINS.md)
!plugin/papyrus/compiled/*.pex
!testesp/compiled/*.pex

# CPython runtime and build inputs, fetched by tools/fetch_python.sh (never committed)
third_party/cpython/
plugin/build-options.local
# testesp/builder is a GPL-3.0-only development tool (Mutagen): never commit its build output
testesp/builder/bin/
testesp/builder/obj/
.playwright-mcp/
OWNER-DECISIONS-*.md
QUESTIONS-*.md
.claude/
# the Windows test box's machine settings (host, user, game folders); see tools/box/box.local.env.example
tools/box/box.local.env
